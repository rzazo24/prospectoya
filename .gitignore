# El proyecto es estático y no tiene build, así que aquí solo se ignoran
# ficheros del sistema operativo, del editor y de un entorno local puntual.

# Sistema operativo / editor
.DS_Store
Thumbs.db
*.log

# Entorno local (no se usan en este proyecto, pero por si acaso)
node_modules/
.env
.venv/

# Documento de contexto local para los asistentes de IA (reglas del proyecto,
# convenciones y qué está verificado): vive en el disco pero no se publica.
AGENTS.md

# Configuración del servidor de desarrollo
.vercel/
